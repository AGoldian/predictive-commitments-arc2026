+# ARC paper additive host request accounting; our additions MIT-0.
+import uuid as _arc_paper_uuid
+_ARC_PAPER_HTTP_LOCK = threading.Lock()
+
+def _arc_paper_safe_usage(payload):
+    if not isinstance(payload, dict):
+        return None
+    result = {}
+    for name in ('prompt_tokens', 'completion_tokens', 'total_tokens', 'input_tokens',
+                 'output_tokens', 'generated_tokens', 'reasoning_tokens'):
+        value = payload.get(name)
+        if type(value) is int and value >= 0:
+            result[name] = value
+    for group, names in (
+        ('prompt_tokens_details', ('cached_tokens', 'image_tokens')),
+        ('completion_tokens_details', ('reasoning_tokens', 'accepted_prediction_tokens', 'rejected_prediction_tokens')),
+    ):
+        values = payload.get(group)
+        if isinstance(values, dict):
+            kept = {name: values[name] for name in names if type(values.get(name)) is int and values[name] >= 0}
+            if kept:
+                result[group] = kept
+    return result or None
+
+def _arc_paper_safe_id(value):
+    return value if isinstance(value, str) and re.fullmatch(r'[A-Za-z0-9_.:-]{1,256}', value) else None
+
+def _arc_paper_http_record(agent, context, event, **fields):
+    if not agent._save_request_logs:
+        return
+    path = getattr(agent, '_arc_paper_http_log_path', None)
+    if path is None:
+        raise RuntimeError('Host HTTP accounting requires an initialized episode.')
+    row = {
+        'schema_version': 1, 'event': event, 'monotonic_ns': time.monotonic_ns(),
+        'host_agent_id': agent._arc_paper_agent_id,
+        'host_episode_id': agent._arc_paper_episode_id,
+        'game_alias': _arc_paper_safe_id(getattr(agent, '_diag_name', None)),
+        'host_call_id': context['call_id'],
+        'host_attempt_id': context.get('attempt_id'),
+        'attempt_ordinal': context.get('attempt_ordinal', 0),
+        **fields,
+    }
+    encoded = json.dumps(row, sort_keys=True, allow_nan=False) + '\n'
+    with _ARC_PAPER_HTTP_LOCK:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open('a', encoding='utf-8') as stream:
+            stream.write(encoded)
+
+def _arc_paper_http_attempt(agent, context, send, *, streamed):
+    context['attempt_id'] = _arc_paper_uuid.uuid4().hex
+    context['attempt_ordinal'] = context.get('attempt_ordinal', 0) + 1
+    started = time.monotonic_ns()
+    context['attempt_started_ns'] = started
+    context['response_accounted'] = False
+    _arc_paper_http_record(agent, context, 'attempt_started', started_ns=started, streamed=streamed)
+    try:
+        response = send()
+    except BaseException as exc:
+        _arc_paper_http_record(agent, context, 'attempt_error', started_ns=started,
+                              ended_ns=time.monotonic_ns(), error_type=type(exc).__name__,
+                              api_usage_unavailable=True)
+        raise
+    status = getattr(response, 'status_code', None)
+    _arc_paper_http_record(agent, context, 'http_return', started_ns=started,
+                          ended_ns=time.monotonic_ns(),
+                          http_status=status if type(status) is int else None,
+                          streamed=streamed, api_usage_unavailable=True)
+    # For streams this records header arrival; parsing completion is separate.
+    # Do not inspect JSON, consume the response, attach IDs, or modify headers.
+    return response
+
+def _arc_paper_response_record(agent, context, response, payload):
+    usage = _arc_paper_safe_usage(payload.get('usage') if isinstance(payload, dict) else None)
+    _arc_paper_http_record(agent, context, 'response_parsed',
+                          started_ns=context.get('attempt_started_ns'), ended_ns=time.monotonic_ns(),
+                          api_response_id=_arc_paper_safe_id(payload.get('id')) if isinstance(payload, dict) else None,
+                          usage=usage, api_usage_unavailable=usage is None,
+                          http_status=getattr(response, 'status_code', None))
+    context['response_accounted'] = True
+
+
