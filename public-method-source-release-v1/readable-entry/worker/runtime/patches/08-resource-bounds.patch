+                    raise BoundsFailure("json_bytes")
+                encoded.extend(raw)
+        except (ValueError, OverflowError, RecursionError, UnicodeError) as exc:
+            raise BoundsFailure("invalid_json") from exc
+        encoded.extend(b"\n")
+        return bytes(encoded)
